# ---- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://diabcar.ma
# Host that serves the admin (default: any host starting with "admin.")
ADMIN_HOST=admin.diabcar.ma
# Allow /admin/* on the public host (useful for previews). Never true in production.
ADMIN_ALLOW_PATH=false

# ---- Database / Auth (Supabase) — leave empty to run in demo mode ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated e-mails allowed into the admin (in addition to app_metadata.role = admin)
ADMIN_EMAILS=admin@diabcar.ma

# ---- Demo mode (no Supabase) --------------------------------------------
ADMIN_DEMO_PASSWORD=diabcar-demo
# Random 32+ chars, used to sign the demo session cookie
AUTH_SECRET=change-me-in-production

# ---- E-mail (Resend) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Diab Car <reservations@diabcar.ma>"
BOOKING_NOTIFY_EMAIL=contact@diabcar.ma

# ---- SEO / analytics --------------------------------------------------------
NEXT_PUBLIC_GA_ID=
INDEXNOW_KEY=
